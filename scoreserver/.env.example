# Copy this file to .env and fill in the database credentials from the course description.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:4200,http://localhost:4000
# Address and port the server listens on (127.0.0.1 = this machine only)
HOST=127.0.0.1
PORT=3000
